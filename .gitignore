# Chave de API — nunca versionar
api_key.txt

# Configuração local do editor/ferramentas
.claude/

# Arquivos temporários de desenvolvimento
_*.txt

# Banco vetorial — gerado automaticamente na indexação
chroma_db/

# Cache de documentos da CVM — baixado automaticamente pelo pipeline
dados/cache/

# Índices e cadastro da CVM — baixados automaticamente (ver README, "Dados").
# dados/ticker_map.csv é versionado: mapa ticker → código CVM curado à mão.
dados/fca_*.csv
dados/meta_*.csv

# Cache do Python
__pycache__/
*.pyc

# Ambiente virtual
venv/
.env
